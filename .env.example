# S3-compatible object storage — destination for the normalized certificates.
# Defaults target Hetzner Object Storage; leave S3_ENDPOINT empty for AWS S3.
AWS_REGION=fsn1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BUCKET=ivory-csca-certificates
S3_PREFIX=csca

# Log level: debug | info | warn | error
LOG_LEVEL=info
